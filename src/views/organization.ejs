<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section>
            <h2>
                <%= organization.name %>
            </h2>

            <p>
                <strong>Description:</strong>
                <%= organization.description %>
            </p>

            <p>
                <strong>Contact Email:</strong>
                <%= organization.contact_email %>
            </p>

            <p>
                <strong>Logo:</strong>
                <%= organization.logo_filename %>
            </p>

            <h3>Projects by this Organization</h3>

            <ul>
                <% projects.forEach((project)=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.project_name %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
        </section>

        <p>
            <a href="/edit-organization/<%= organization.organization_id %>">
                Edit Organization
            </a>
        </p>

        <a href="/organizations">Back to Organizations</a>


    </main>

    <%- include('partials/footer') %>