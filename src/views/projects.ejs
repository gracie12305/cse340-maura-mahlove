<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>

        <ul>
            <% projects.forEach((project)=> { %>
                <li>
                    <strong>
                        <%= project.project_name %>
                    </strong> -
                    <%= project.description %>
                        <p>Organization: <%= project.organization_name %>
                        </p>
                </li>
                <% }) %>
        </ul>

    </main>

    <%- include('partials/footer') %>