<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <ul>
            <% projects.forEach((project)=> { %>
                <li>
                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h2>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        Organization:
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <p>
                        <a href="/assign-categories/<%= project.project_id %>">
                            Edit Categories
                        </a>
                    </p>

                    <p><a href="/new-project">Add a New Service Project</a></p>

                </li>
                <% }) %>
        </ul>
    </main>

    <%- include('partials/footer') %>