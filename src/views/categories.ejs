<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Explore Service Project Categories</h2>

        <p>
            Discover different ways to make a positive impact
            in your community.
        </p>

        <ul>
            <% categories.forEach((category)=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>

                    <p>
                        <a href="/new-category">Add New Category</a>
                    </p>
                    
                </li>
                <% }) %>
        </ul>
    </main>

    <%- include('partials/footer') %>